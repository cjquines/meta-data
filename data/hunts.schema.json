{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Full name of hunt."
      },
      "from": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "First indexed year."
      },
      "to": {
        "description": "Last indexed years, inclusive. When omitted, equals `from`.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "name",
      "from"
    ],
    "additionalProperties": false
  },
  "description": "Record from hunt abbreviation to data."
}
